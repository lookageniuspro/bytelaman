{
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/join.html", "destination": "/join-us", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    }
  ]
}
